node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Local env — never commit keys
.env
.env.local

# SQLite dev database.
#
# The trailing * is not decoration. `prisma/*.db` alone does not match
# `dev.db.backup-20260812-173337`, and a backup of the dev database contains real
# addresses and password hashes — it was caught on the way to a public repo exactly once,
# by the host rather than by this file. Match anything that starts with the database name.
prisma/*.db
prisma/*.db-*
prisma/*.db-journal
*.sqlite
*.sqlite3
*.backup-*

# Uploaded media and derived artifacts stay out of git
storage/

# Whisper models
models/

# Local editor / tooling config — nothing the app or the Space needs.
.claude/

.DS_Store
